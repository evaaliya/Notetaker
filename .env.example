# Имя проекта Compose (тома = <имя>_pgdata / <имя>_uploads).
# По умолчанию = имя папки репозитория. Задайте явно при второй копии на той же машине:
# COMPOSE_PROJECT_NAME=notetaker-copy2

# Хост-порты (внутри сети compose api всё ещё :8000, postgres :5432, …)
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Значения по умолчанию рабочие для локального запуска
POSTGRES_USER=notetaker
POSTGRES_PASSWORD=notetaker
POSTGRES_DB=notetaker
DATABASE_URL=postgresql+asyncpg://notetaker:notetaker@postgres:5432/notetaker

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=notetaker@localhost

SESSION_TTL_HOURS=720
COOKIE_SECURE=false

WORKER_TICK_SECONDS=1
WORKER_BATCH_SIZE=100
RECURRENCE_HORIZON_DAYS=60
TRASH_RETENTION_DAYS=30
OUTBOX_SENDING_TIMEOUT_MINUTES=2

# Playwright / local e2e only — never enable in production
E2E_HOOKS=false

UPLOADS_DIR=/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PER_NOTE=10

# M11: stub (default, no keys/network) | openrouter
AI_PROVIDER=stub
# OPENROUTER_API_KEY=
# Бесплатно по умолчанию (роутер :free). Платные — явно:
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Опционально (есть дефолты в api/app/config.py) — таймауты extract / YouTube (M14/M21)
# YOUTUBE_CAPTIONS_TIMEOUT_SEC=15
# OPENROUTER_TIMEOUT_SEC=60
# EXTRACT_JOB_DEADLINE_SEC=90
# EXTRACT_PENDING_TTL_SEC=60
# EXTRACT_TRANSIENT_RETRIES=1
# EXTRACT_RETRY_PAUSE_SEC=1
# YOUTUBE_CAPTION_CACHE_TTL_HOURS=24
